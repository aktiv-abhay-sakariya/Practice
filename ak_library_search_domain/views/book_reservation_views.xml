<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- List View: Displays a table of reservation book -->
    <record id='book_reservation_view_list' model='ir.ui.view'>
        <field name="name">book.reservation.view.list</field>
        <field name="model">book.reservation</field>
        <field name="arch" type="xml">
            <list>
                <field name='book_id'/>
                <field name='reservation_date'/>
                <field name='expected_pickup_date'/>
                <field name='state'/>
            </list>
        </field>
    </record>
    
    <!-- Form View: Detailed view for editing/creating an book reservation -->
    <record id='book_reservation_view_form' model='ir.ui.view'>
        <field name="name">book.reservation.view.form</field>
        <field name="model">book.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation Form">
                <header>
                    <button name="book_reservation_analysis"
                            string="Reservation Analysis"
                            type="object"
                            class="oe_highlight"/>
                    <button name="action_send_mail"
                            string="Send Email"
                            type="object"
                            invisible="state != 'reserved'"/>
                    <field name='state'
                           widget='statusbar'
                           options="{'clickable': 
                                'ak_library_search_domain.librarian_group,
                                ak_library_search_domain.library_manager_group'
                            }"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name='book_id' 
                                   options="{
                                        'no_create': True,
                                        'no_create_edit': True,
                                        'no_open': True
                                    }"/>
                            <field name='reservation_date'/>
                        </group>
                        <group>
                            <field name='customer_id'
                                   options="{
                                        'no_create': True,
                                        'no_create_edit': True,
                                        'no_open': True
                                    }"/>
                            <field name='expected_pickup_date'/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name='create_uid'
                                   groups="ak_library_search_domain.library_manager_group"/>
                            <field name='write_uid'
                                   groups="ak_library_search_domain.library_manager_group"/>
                        </group>
                        <group>
                            <field name='create_date'
                                   groups="ak_library_search_domain.library_manager_group"/>
                            <field name='write_date'
                                   groups="ak_library_search_domain.library_manager_group"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action: Defines how to open the book reservation records -->
    <record model="ir.actions.act_window" id="menu_access_book_reservation">
        <field name="name">Reservation</field>
        <field name="res_model">book.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="help">Add Reservation</field>
    </record>

    <!-- Reservation menu : Add sub menu in Library management main menu-->
    <menuitem id="sub_menu_access_book_reservation"
              name="Reservation"
              parent="ak_library_management.main_menu_access"
              action="menu_access_book_reservation"/>

</odoo>
