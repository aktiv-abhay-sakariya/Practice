<odoo>

    <record id="view_job_form_inherit_landrovers" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.landrovers</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Position Requirements">
                    <group>
                        <group>
                            <field name="minimum_education"/>
                            <field name="minimum_prior_experience"/>
                        </group>
                        <group>
                            <field name="required_prior_training"/>
                            <field name="required_certifications"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>