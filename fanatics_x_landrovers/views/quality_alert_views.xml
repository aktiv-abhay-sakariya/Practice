<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit quality_control.quality_alert_view_form -->
    <record id="view_quality_alert_form_inherit_fanatics" model="ir.ui.view">
        <field name="name">quality.alert.form.inherit.fanatics</field>
        <field name="model">quality.alert</field>
        <field name="inherit_id" ref="quality_control.quality_alert_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="project_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='reason_id']" position="after">
                <field name="vehicle_detail_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

</odoo>