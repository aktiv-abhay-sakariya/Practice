<odoo>
    <record id="action_create_project_from_opportunity_fanatics_x_landrovers" model="ir.actions.server">
        <field name="name">Create Project</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = record.action_create_project_from_won_opportunity()</field>
    </record>

    <record id="form_crm_lead_crm_crm_lead_view_form_fanatics_x_landrovers" model="ir.ui.view">
        <field name="name">pform_crm_lead_crm_crm_lead_view_form_fanatics_x_landrovers_</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="won_project_is_created" invisible="1"/>
            </xpath>
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_open_project_won_opportunity" icon="fa-check" invisible="not won_project_is_created">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Project</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>