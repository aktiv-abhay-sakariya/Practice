<odoo>
    <data noupdate="1">
        <record id="product_internal_reference_seq" model="ir.sequence">
            <field name="name">Internal Reference Sequence</field>
            <field name="code">product.internal.reference</field>
            <field name="prefix">TLR-</field>
            <field name="padding">6</field>
        </record>

        <record id="product_barcode_seq" model="ir.sequence">
            <field name="name">Internal Reference Sequence</field>
            <field name="code">product.barcode</field>
            <field name="prefix"></field>
            <field name="padding">12</field>
        </record>

        <record id="seq_project_build_slot_fanatics_x_landrovers" model="ir.sequence">
            <field name="name">Project Build Slot Unique Number</field>
            <field name="code">project.build.slot.unique.number</field>
            <field name="padding">0</field>
            <field name="number_increment">1</field>
            <field name="number_next">256</field>
        </record>
    </data>
</odoo>