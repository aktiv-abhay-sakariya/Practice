<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List View: Displays a table of vehicle details -->
    <record id='vehicle_detail_view_list' model='ir.ui.view'>
        <field name="name">vehicle.detail.view.list</field>
        <field name="model">vehicle.detail</field>
        <field name="arch" type="xml">
            <list>
                <field name='vehicle_name'/>
                <field name='warranty_length'/>
                <field name='description'/>
            </list>
        </field>
    </record>

    <!-- Form View: Detailed view for editing/creating a vehicle detail-->
    <record id='vehicle_detail_view_form' model='ir.ui.view'>
        <field name="name">vehicle.detail.view.form</field>
        <field name="model">vehicle.detail</field>
        <field name="arch" type="xml">
            <form string="Idea form">
                <header></header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_view" type="object"
                                class="oe_stat_button" icon="fa-tasks" context="{'is_project': True}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Project</span>
                                <field name="total_projects" class="o_stat_value"/>
                            </div>
                        </button>
                        <button name="action_open_view" type="object"
                                class="oe_stat_button" icon="fa-tasks" context="{'is_project_service_warranty': True}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Service Warranty</span>
                                <field name="total_service_warranty" class="o_stat_value"/>
                            </div>
                        </button>
                        <button name="action_open_view" type="object"
                                class="oe_stat_button" icon="fa-car" context="{'is_donor_vehicle': True}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Donor Vehicle</span>
                                <field name="total_donor_vehicles" class="o_stat_value"/>
                            </div>
                        </button>
                        <button name="action_open_view" type="object"
                                class="oe_stat_button" icon="fa-user" context="{'is_customer_requirements': True}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Customer</span>
                                <field name="total_customer_requirements" class="o_stat_value"/>
                            </div>
                        </button>
                        <button name="action_open_view" type="object"
                                class="oe_stat_button" icon="fa-check" context="{'is_quality_alert': True}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Quality</span>
                                <field name="total_quality_alert" class="o_stat_value"/>
                            </div>
                        </button>
                    </div>
                    <group>
                        <field name='vehicle_name'/>
                        <field name='warranty_length'/>
                        <field name='description'/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action: Defines how to open the vehicle records -->
    <record model="ir.actions.act_window" id="action_vehicle_detail">
        <field name="name">Vehicles</field>
        <field name="res_model">vehicle.detail</field>
        <field name="view_mode">list,form</field>
        <field name="help">Add vehicle</field>
    </record>

    <menuitem id="sub_menu_vehicle_detail" name="Vehicles"
              parent="project.menu_project_config" action="action_vehicle_detail"/>
</odoo>