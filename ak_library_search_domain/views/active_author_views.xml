<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

   <!-- inherit Form View: add new field and chatter author-->
    <record id="author_author_view_form_inherit_domain" model="ir.ui.view">
        <field name="name">author.author.view.form.inherit.domain</field>
        <field name="model">author.author</field>
        <field name="inherit_id"
            ref="ak_library_management_enhancement.author_author_view_form_inherit"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='social_profile']" position="after">
               <field name="user_id"
                      options="{
                        'no_create': True,
                        'no_create_edit': True,
                        'no_open': True
                     }"/>
            </xpath>

            <xpath expr="//sheet" position="after">
               <chatter/>
            </xpath>
            
        </field>
    </record>

   <!-- Action: Defines how to open the author records -->
   <record id="menu_active_author" model="ir.actions.act_window">
      <field name="name">Active Author</field>
      <field name="res_model">author.author</field>
      <field name="view_mode">list,form</field>
      <field name="view_ids" eval="[
         (5,0,0),
         (0,0,{
            'view_mode':'list',
            'view_id':ref('ak_library_management_enhancement.author_author_view_list_inherit')
         }),
         (0,0,{
            'view_mode':'form',
            'view_id':ref('author_author_view_form_inherit_domain')
         })
      ]"/>
      <field name='domain'>[('author_status','=','active')]</field>
   </record>

    
   <menuitem id="sub_menu_access_active_author"
             name="Active Author"
             parent="ak_library_management.menu_access" 
             action="menu_active_author"
             sequence='2'/>
</odoo>
